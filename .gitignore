# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build artifacts
build/
dist/
site/
*.egg-info/
pip-wheel-metadata/

# Test and quality tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Local configuration and secrets
.env
.env.*
config/saas.yaml
config/devices.yaml
config/auth.yaml
!.env.example

# Logs and runtime files
*.log
*.pid
*.seed

# OS files
.DS_Store
Thumbs.db

# Keep VS Code workspace settings under version control
!.vscode/
!.vscode/launch.json

# Optional local databases
*.db
*.sqlite3

# node_modules and frontend build artifacts
node_modules/
dist/

# Nginx ignore by the moment.
nginx/

